# Copy this file to .env for local development (never commit the real .env)

SECRET_KEY=change-this-to-a-random-string

# Free Gemini AI key - powers handwriting OCR + the "ask a question" feature.
# 1. Go to https://aistudio.google.com/apikey
# 2. Sign in with any Google account, click "Create API key" (no card needed)
# 3. Paste it below
GEMINI_API_KEY=your-gemini-api-key-here

# Brevo (formerly Sendinblue) - free email API, up to 300 emails/day, no card needed.
# Used to send the "Welcome to ScanMate" email after registration.
# 1. Sign up free at https://www.brevo.com
# 2. Go to your Brevo dashboard -> SMTP & API -> API Keys -> Generate a new key
# 3. Paste that key below as BREVO_API_KEY
# 4. MAIL_FROM must be an email address you've verified as a sender in Brevo
#    (Brevo dashboard -> Senders & IP -> Senders -> Add a sender)
BREVO_API_KEY=your-brevo-api-key-here
MAIL_FROM=youraddress@gmail.com

# Optional: the live URL of your deployed app, used in the "Start Scanning Now"
# button inside the welcome email. Leave blank while developing locally.
APP_URL=https://your-app-name.onrender.com
